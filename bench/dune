; Benchmarks build in the dev and release profiles. Take numbers you intend
; to compare from release builds: dune build --profile release

(library
 (name bench_routes)
 (modules bench_routes)
 (enabled_if
  (or
   (= %{profile} dev)
   (= %{profile} release)))
 (libraries tapak))

(executable
 (name route_bench)
 (public_name tapak-route-bench)
 (package tapak)
 (enabled_if
  (or
   (= %{profile} dev)
   (= %{profile} release)))
 (modules route_bench)
 (libraries tapak bench_routes bytesrw benchmark))

(executable
 (name server_bench)
 (public_name tapak-server-bench)
 (package tapak)
 (enabled_if
  (or
   (= %{profile} dev)
   (= %{profile} release)))
 (modules server_bench)
 (libraries tapak bench_routes eio eio_main unix))
