opam-version: "2.0"
synopsis:
  "Sch schema validation implementation for melange, see main sch library for more information"
description: """
Sch is schema validation, serialization and deserialization OCaml data structure
"""
maintainer: ["Syaiful Bahri <syai.bahri6@gmail.com>"]
authors: ["Syaiful Bahri <syai.bahri6@gmail.com>"]
